# ============================================================
# Financo — Variáveis de ambiente para BUILD MOBILE (Capacitor)
# ============================================================
# Copie este arquivo para .env.mobile e preencha antes de rodar:
#   npm run build:mobile

# URL do seu deploy de produção (Vercel, Railway, etc.)
# O app Android fará todas as chamadas de API para este endereço.
NEXT_PUBLIC_API_BASE_URL=https://SEU-APP.vercel.app

# Reuse as mesmas credenciais Supabase da produção
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
